# ------------------------------------------------------------------
# LearnPath AI — environment configuration
# Copy to `.env` and fill in. The app runs fully offline without any
# of these values (local deterministic fallbacks are used).
# ------------------------------------------------------------------

# ---- LLM Provider (optional) --------------------------------------
# Choose: "local" (default, offline, deterministic) or "openai".
LLM_PROVIDER=local

# OpenAI-compatible API key — only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Embeddings (optional) ----------------------------------------
# "tfidf" (default, offline) or "sentence-transformers"
EMBEDDING_PROVIDER=tfidf

# Name of a sentence-transformers model when EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- App -----------------------------------------------------------
# Path to the SQLite database file
DATABASE_PATH=data/learnpath.db

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Where the static asset folder lives (logo, images)
ASSET_DIR=assets
